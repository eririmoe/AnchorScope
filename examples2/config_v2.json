{
  "$schema": "../src/anchorscope/config.schema.json",
  "sample_name": "example_v2",
  "qscore_method": "conservative",
  "anchors": [
    {
      "name": "adapter_5p",
      "type": "fixed",
      "sequence": "CGACATGGCTACGATCCGACTT",
      "max_edits": 2,
      "search_region": "5p",
      "search_window_bp": 180
    },
    {
      "name": "polyA",
      "type": "regex",
      "pattern": "A{8,}",
      "search_region": "3p",
      "search_window_bp": 250
    }
  ],
  "structure": {
    "expected_order": ["adapter_5p", "polyA"],
    "expected_orientation": "either",
    "concatemer_min_cycles": 2,
    "split_concatemers": true,
    "anchor_rules": {
      "adapter_5p": {
        "required": true,
        "min_count": 1,
        "max_count": 1,
        "terminal": "5p",
        "max_terminal_offset": 0.2
      },
      "polyA": {
        "required": true,
        "min_count": 1,
        "max_count": 1,
        "terminal": "3p",
        "max_terminal_offset": 0.25
      }
    },
    "segments": [
      {
        "name": "transcript_insert",
        "start_anchor": "adapter_5p",
        "end_anchor": "polyA",
        "role": "insert",
        "min_length": 100,
        "max_length": 10000
      }
    ]
  },
  "barcode": {"enabled": false},
  "thresholds": {
    "long_read_min_bp": 200,
    "long_read_min_q": 13,
    "terminal_anchor_max_offset": 0.2,
    "high_n_fraction": 0.1
  }
}
